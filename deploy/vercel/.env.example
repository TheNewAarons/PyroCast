# Variables del proyecto de Vercel (Settings -> Environment Variables). Ver DEPLOY.md.
# Copia a .env.local SOLO para probar localmente; nunca lo commitees.

# Opcional pero recomendada: sin ella /active-fires responde un error claro y el
# mapa avisa "Incendios activos no disponibles". Gratis en
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Opcionales (valores por defecto seguros):
# ENVIRONMENT=production            # "development" activa /docs
# CORS_ALLOW_ORIGINS=[]             # JSON; vacío = sin CORS (el mapa es del mismo origen)
# PYROCAST_DATA_URL=                # sobreescribe la URL de data-bundle.json
# PYROCAST_DATA_SHA256=             # obligatoria si se usa PYROCAST_DATA_URL
